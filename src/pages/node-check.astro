---
import Layout from '../components/Layout.astro';
---
<Layout
  title="Node Check — MeshTexas"
  description="Is your MeshCore node getting out? See which observers hear it across Texas, and what to fix if something's wrong."
>
  <div class="page-intro nc-intro">
    <div class="container-narrow">
      <h1>Node Check</h1>
      <p class="hero-sub">Is your node getting out? See which observers across Texas hear it, and what to fix if something looks wrong.</p>

      <form class="nc-search" id="nc-form" role="search">
        <label for="nc-query" class="visually-hidden">Node name, public key, or shared contact link</label>
        <div class="nc-search-box">
          <input id="nc-query" name="q" type="text" autocomplete="off" autocapitalize="off" spellcheck="false"
            placeholder="Node name, public key, or shared contact link" required maxlength="300">
          <button type="submit" class="nc-btn nc-btn-primary" id="nc-submit">Check</button>
        </div>
        <p class="nc-mine" id="nc-mine" hidden></p>
      </form>
    </div>
  </div>

  <section class="nc-body">
    <div class="container-narrow">
      <div id="nc-result" aria-live="polite"></div>

      <div class="nc-help">
        <h2 class="nc-group-title">Help</h2>
        <details class="hint-collapsible">
          <summary>Where do I find my node's public key?</summary>
          <div class="hint-body">
            <p>In the MeshCore app, a companion's public key is in its settings. For a repeater or room server, it's shown when you log in to manage it. You can also share the node as a contact and paste the link here.</p>
            <p>The first 8 or more characters of the key are enough. Names work too, but several nodes can share a name.</p>
          </div>
        </details>
        <details class="hint-collapsible">
          <summary>How do I send a flood advert?</summary>
          <div class="hint-body">
            <p>A flood advert is relayed by every repeater that hears it, so it shows how far your node really reaches. A zero-hop advert only reaches radios in direct range.</p>
            <p>In the MeshCore app, send an advert and choose Flood. On a repeater or room server, use the <code>advert</code> command. Give it a minute to reach the observers, then check again.</p>
          </div>
        </details>
        <p class="nc-footnote">Results come from the <a href="https://analyzer.meshtexas.org" target="_blank" rel="noopener">MeshTexas analyzer ↗</a>, which only hears what reaches one of its observers. They update about every 30 seconds.</p>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .nc-intro { padding-bottom: 40px; }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  /* Search, part of the intro */
  .nc-search { margin-top: 28px; }
  .nc-search-box {
    display: flex; gap: 6px; padding: 6px;
    background: var(--bg-2); border: 1px solid var(--border); border-radius: 12px;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
  }
  .nc-search-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(31, 111, 235, 0.18); }
  .nc-search-box input {
    flex: 1; min-width: 0; border: 0; background: transparent; color: var(--text);
    padding: 10px 12px; font: inherit; font-size: 1rem;
  }
  .nc-search-box input:focus { outline: none; }
  .nc-mine { margin: 10px 2px 0; font-size: 0.85rem; color: var(--text-muted); }

  .nc-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    padding: 8px 14px; border-radius: 8px; font: inherit; font-size: 0.875rem; font-weight: 500;
    border: 1px solid var(--border); background: var(--bg-3); color: var(--text);
    cursor: pointer; white-space: nowrap; text-decoration: none;
  }
  .nc-btn:hover { border-color: var(--accent); text-decoration: none; color: var(--text); }
  .nc-btn-primary { background: var(--accent-dim); border-color: var(--accent-dim); color: #fff; padding: 10px 22px; font-size: 0.95rem; }
  .nc-btn-primary:hover { background: var(--accent); border-color: var(--accent); color: #fff; }
  .nc-btn:disabled { opacity: 0.6; cursor: progress; }
  .nc-linkish { background: none; border: 0; padding: 0; font: inherit; color: var(--accent); cursor: pointer; }
  .nc-linkish:hover { text-decoration: underline; }

  /* Results */
  .nc-body { padding: 40px 0 64px; }
  #nc-result:not(:empty) { margin-bottom: 48px; }
  .nc-stack { display: flex; flex-direction: column; gap: 20px; }
  .nc-panel {
    background: var(--bg-2); border: 1px solid var(--border); border-radius: 12px;
    padding: 24px;
  }
  .nc-panel > h2, .nc-panel-head h2 { font-size: 1.05rem; margin: 0; letter-spacing: -0.01em; }
  .nc-panel-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 16px; margin-bottom: 4px; }
  .nc-panel-sub { margin: 0 0 16px; font-size: 0.875rem; color: var(--text-muted); }
  .nc-loading { color: var(--text-muted); padding: 8px 2px; }

  /* Good is NodeScope's orange (iOS system orange), darkened in light mode so
     text stays readable; warnings lean yellow so the two don't blur together. */
  :root { --nc-red: #f85149; --nc-orange: #ff9f0a; --nc-yellow: #e3c341; }
  [data-theme="light"] { --nc-red: #cf222e; --nc-orange: #c25700; --nc-yellow: #8f6a00; }
  .tone-good { --tone: var(--nc-orange); }
  .tone-warn { --tone: var(--nc-yellow); }
  .tone-bad { --tone: var(--nc-red); }
  .tone-info { --tone: var(--accent); }

  /* Summary */
  .nc-summary { border-top: 4px solid var(--tone); }
  .nc-summary-top { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .nc-name { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.02em; margin: 0 0 6px; word-break: break-word; }
  .nc-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; font-size: 0.85rem; color: var(--text-muted); }
  .nc-chip {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 2px 10px; border-radius: 999px; font-size: 0.78rem; font-weight: 500;
    border: 1px solid var(--border); color: var(--text-muted); text-transform: capitalize;
  }
  .nc-key { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.8rem; }
  .nc-status {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 16px;
    padding: 6px 14px 6px 10px; border-radius: 999px; font-weight: 600; font-size: 0.95rem;
    color: var(--tone);
    background: color-mix(in srgb, var(--tone) 12%, transparent);
  }
  .nc-status::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--tone); }
  .nc-actions { display: flex; flex-wrap: wrap; gap: 8px; }

  .nc-stats {
    display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px;
    margin-top: 20px; border: 1px solid var(--border); border-radius: 10px; overflow: hidden;
    background: var(--border);
  }
  .nc-stat { background: var(--bg-3); padding: 14px 16px; }
  .nc-stat-label { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); }
  .nc-stat-value { font-size: 1.25rem; font-weight: 700; margin-top: 4px; font-variant-numeric: tabular-nums; }
  .nc-stat-note { font-size: 0.8rem; color: var(--text-muted); margin-top: 2px; }

  /* Findings */
  .nc-group + .nc-group { margin-top: 22px; padding-top: 22px; border-top: 1px solid var(--border); }
  .nc-group-title {
    font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em;
    color: var(--text-muted); margin: 0 0 12px;
  }
  .nc-findings { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  .nc-finding { display: grid; grid-template-columns: 26px 1fr; column-gap: 12px; align-items: start; }
  .nc-icon {
    width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center;
    font-size: 0.8rem; font-weight: 700; line-height: 1;
    color: var(--tone); background: color-mix(in srgb, var(--tone) 14%, transparent);
  }
  .nc-finding-title { font-weight: 600; line-height: 1.4; padding-top: 2px; }
  .nc-finding p { grid-column: 2; margin: 3px 0 0; font-size: 0.9rem; color: var(--text-muted); line-height: 1.55; }
  .nc-fix {
    margin-top: 8px !important; padding: 8px 12px; border-radius: 8px;
    background: var(--bg-3); color: var(--text) !important;
  }
  .nc-fix strong { font-weight: 600; }

  /* Observer lists */
  .nc-region + .nc-region { margin-top: 18px; }
  .nc-region-head { display: flex; align-items: baseline; gap: 8px; margin-bottom: 6px; }
  .nc-region-code {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 600; font-size: 0.8rem;
    padding: 1px 8px; border-radius: 6px; background: var(--bg-3); border: 1px solid var(--border);
  }
  .nc-region-count { font-size: 0.8rem; color: var(--text-muted); }
  .nc-rows { list-style: none; margin: 0; padding: 0; }
  .nc-row {
    display: grid; grid-template-columns: minmax(0, 1fr) 84px 150px; align-items: center; gap: 12px;
    padding: 9px 4px; border-bottom: 1px solid var(--border); font-size: 0.9rem;
  }
  .nc-row:last-child { border-bottom: 0; }
  .nc-row-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .nc-hops {
    justify-self: start; font-size: 0.75rem; font-weight: 500; padding: 2px 8px; border-radius: 999px;
    background: var(--bg-3); color: var(--text-muted); white-space: nowrap;
  }
  .nc-hops.direct { color: var(--nc-orange); background: color-mix(in srgb, var(--nc-orange) 14%, transparent); }
  .nc-signal { display: flex; flex-direction: column; gap: 4px; font-variant-numeric: tabular-nums; }
  .nc-signal-text { display: flex; justify-content: space-between; gap: 8px; font-size: 0.82rem; }
  .nc-signal-text .rssi { color: var(--text-muted); }
  .nc-bar { height: 4px; border-radius: 2px; background: var(--bg-3); overflow: hidden; }
  .nc-bar span { display: block; height: 100%; border-radius: 2px; background: var(--tone); }
  .nc-more { margin-top: 8px; font-size: 0.85rem; }

  /* Choices */
  .nc-choices { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px; }
  .nc-choices button {
    width: 100%; text-align: left; cursor: pointer; font: inherit; color: var(--text);
    background: var(--bg-3); border: 1px solid var(--border); border-radius: 10px;
    padding: 12px 16px; display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; justify-content: space-between;
  }
  .nc-choices button:hover { border-color: var(--accent); }
  .nc-choice-meta { font-size: 0.8rem; color: var(--text-muted); }

  .nc-message h2 { color: var(--tone); font-size: 1.2rem; margin: 0 0 10px; }
  .nc-message p { margin: 0 0 8px; line-height: 1.6; color: var(--text-muted); }
  .nc-message { border-top: 4px solid var(--tone); }

  /* Help */
  .nc-help { display: flex; flex-direction: column; gap: 10px; }
  .nc-help .nc-group-title { margin-bottom: 2px; }
  .nc-footnote { margin-top: 10px; font-size: 0.8rem; color: var(--text-muted); }

  @media (max-width: 640px) {
    .nc-search-box { flex-direction: column; }
    .nc-panel { padding: 18px; }
    .nc-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .nc-row { grid-template-columns: minmax(0, 1fr) auto; }
    .nc-row .nc-signal { grid-column: 1 / -1; }
    .nc-actions { width: 100%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
    .nc-actions .nc-btn { padding: 8px 6px; }
  }
</style>

<script>
  type Finding = { level: string; title: string; detail: string; fix: string | null };
  type Observer = { name: string; region: string | null; hops?: number | null; snr: number | null; rssi: number | null; packets?: number | null };
  type Report = {
    status: 'ok';
    node: { key: string; name: string; role: string; lastHeard: string | null };
    verdict: { level: string; headline: string };
    findings: Finding[];
    latestAdvert: { at: string | null; kind: string | null; observers: Observer[]; regions: string[] } | null;
    direct: Observer[];
    analyzerUrl: string;
  };
  type Response =
    | Report
    | { status: 'not_found'; query: string; findings: Finding[] }
    | { status: 'choose'; query: string; matches: { key: string; name: string; role: string; lastHeard: string | null }[] }
    | { status: 'ambiguous' | 'error'; message: string };

  const STORAGE_KEY = 'meshtexas-node-check';
  const ROWS_PER_REGION = 5;
  const ICONS: Record<string, string> = { good: '✓', warn: '!', bad: '✕', info: 'i' };
  const form = document.getElementById('nc-form') as HTMLFormElement;
  const input = document.getElementById('nc-query') as HTMLInputElement;
  const submit = document.getElementById('nc-submit') as HTMLButtonElement;
  const result = document.getElementById('nc-result') as HTMLElement;
  const mine = document.getElementById('nc-mine') as HTMLElement;

  function el<K extends keyof HTMLElementTagNameMap>(tag: K, props: Record<string, string> = {}, ...children: (Node | string | null | false)[]) {
    const node = document.createElement(tag);
    for (const [key, value] of Object.entries(props)) {
      if (key === 'class') node.className = value;
      else node.setAttribute(key, value);
    }
    for (const child of children) if (child) node.append(child);
    return node;
  }

  function relative(iso: string | null) {
    if (!iso) return 'unknown';
    const diff = Math.max(0, Date.now() - Date.parse(iso));
    const minutes = Math.round(diff / 60000);
    if (minutes < 2) return 'just now';
    if (minutes < 60) return `${minutes} min ago`;
    const hours = Math.round(minutes / 60);
    if (hours < 24) return `${hours} h ago`;
    return `${Math.round(hours / 24)} d ago`;
  }

  function shortDate(iso: string | null) {
    if (!iso) return 'Not heard';
    const date = new Date(iso);
    const today = new Date().toDateString() === date.toDateString();
    return today
      ? `Today, ${date.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' })}`
      : date.toLocaleDateString([], { month: 'short', day: 'numeric' });
  }

  function hopsLabel(hops: number | null | undefined) {
    if (hops == null) return el('span', { class: 'nc-hops' }, '—');
    return hops === 0
      ? el('span', { class: 'nc-hops direct' }, 'Direct')
      : el('span', { class: 'nc-hops' }, `${hops} ${hops === 1 ? 'hop' : 'hops'}`);
  }

  function signal(o: Observer) {
    if (o.snr == null && o.rssi == null) return el('span', { class: 'nc-signal' }, '—');
    // SNR from -15 dB (barely decodable) to +12 dB (strong) fills the bar.
    const snr = o.snr ?? -15;
    const fill = Math.max(4, Math.min(100, ((snr + 15) / 27) * 100));
    const tone = snr >= 5 ? 'good' : snr >= -5 ? 'warn' : 'bad';
    return el('span', { class: 'nc-signal' },
      el('span', { class: 'nc-signal-text' },
        el('span', {}, o.snr == null ? '—' : `${o.snr > 0 ? '+' : ''}${o.snr} dB SNR`),
        el('span', { class: 'rssi' }, o.rssi == null ? '' : `${o.rssi} dBm`),
      ),
      el('span', { class: `nc-bar tone-${tone}`, 'aria-hidden': 'true' }, el('span', { style: `width:${fill}%` })),
    );
  }

  function remembered(): { key: string; name: string } | null {
    try {
      const value = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
      return value && typeof value.key === 'string' ? value : null;
    } catch {
      return null;
    }
  }

  function remember(key: string, name: string) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify({ key, name })); } catch {}
    showMine();
  }

  function showMine() {
    const saved = remembered();
    if (!saved) { mine.hidden = true; return; }
    const again = el('button', { type: 'button', class: 'nc-linkish' }, saved.name);
    again.addEventListener('click', () => run(saved.key));
    mine.replaceChildren('Last checked: ', again);
    mine.hidden = false;
  }

  function finding(f: Finding) {
    return el('li', { class: `nc-finding tone-${f.level}` },
      el('span', { class: 'nc-icon', 'aria-hidden': 'true' }, ICONS[f.level] || 'i'),
      el('span', { class: 'nc-finding-title' }, f.title),
      el('p', {}, f.detail),
      f.fix ? el('p', { class: 'nc-fix' }, el('strong', {}, 'What to do: '), f.fix) : null,
    );
  }

  function findingsPanel(findings: Finding[]) {
    const groups: [string, Finding[]][] = [
      ['Needs attention', findings.filter((f) => f.level === 'bad' || f.level === 'warn')],
      ['Looking good', findings.filter((f) => f.level === 'good')],
      ['Good to know', findings.filter((f) => f.level === 'info')],
    ];
    return el('div', { class: 'nc-panel' },
      ...groups.filter(([, list]) => list.length).map(([title, list]) =>
        el('div', { class: 'nc-group' },
          el('h3', { class: 'nc-group-title' }, title),
          el('ul', { class: 'nc-findings' }, ...list.map(finding)),
        )),
    );
  }

  function observerRow(o: Observer, extra: Node | null = null) {
    return el('li', { class: 'nc-row' },
      el('span', { class: 'nc-row-name', title: o.name }, o.name),
      extra ?? hopsLabel(o.hops),
      signal(o),
    );
  }

  /** Observers grouped by region, largest group first, a few rows each. */
  function byRegion(observers: Observer[], extra?: (o: Observer) => Node) {
    const groups = new Map<string, Observer[]>();
    for (const o of observers) {
      const key = o.region || 'Unknown';
      groups.set(key, [...(groups.get(key) || []), o]);
    }
    // Regions with the closest observer first, matching the order within each.
    const closest = (list: Observer[]) => Math.min(...list.map((o) => o.hops ?? 99));
    const ordered = [...groups.entries()].sort((a, b) =>
      closest(a[1]) - closest(b[1]) || b[1].length - a[1].length || a[0].localeCompare(b[0]));
    return el('div', {}, ...ordered.map(([region, list]) => {
      const rows = el('ul', { class: 'nc-rows' }, ...list.slice(0, ROWS_PER_REGION).map((o) => observerRow(o, extra ? extra(o) : null)));
      const hidden = list.length - ROWS_PER_REGION;
      let more: HTMLElement | null = null;
      if (hidden > 0) {
        more = el('button', { type: 'button', class: 'nc-linkish nc-more' }, `Show ${hidden} more in ${region}`);
        more.addEventListener('click', () => {
          rows.append(...list.slice(ROWS_PER_REGION).map((o) => observerRow(o, extra ? extra(o) : null)));
          more!.remove();
        });
      }
      return el('div', { class: 'nc-region' },
        el('div', { class: 'nc-region-head' },
          el('span', { class: 'nc-region-code' }, region),
          el('span', { class: 'nc-region-count' }, `${list.length} ${list.length === 1 ? 'observer' : 'observers'}`),
        ),
        rows,
        more,
      );
    }));
  }

  function stat(label: string, value: string, note: string) {
    return el('div', { class: 'nc-stat' },
      el('div', { class: 'nc-stat-label' }, label),
      el('div', { class: 'nc-stat-value' }, value),
      el('div', { class: 'nc-stat-note' }, note),
    );
  }

  function renderReport(report: Report) {
    const shareUrl = `${location.origin}/node-check/${report.node.key.slice(0, 16)}`;
    const copy = el('button', { type: 'button', class: 'nc-btn' }, 'Copy link');
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(shareUrl);
        copy.textContent = 'Link copied';
      } catch {
        copy.textContent = shareUrl;
      }
    });
    const again = el('button', { type: 'button', class: 'nc-btn' }, 'Check again');
    again.addEventListener('click', () => run(report.node.key));

    const advert = report.latestAdvert;
    const heard = advert?.observers || [];
    const nearest = heard.length ? heard[0].hops : null;
    const level = report.verdict.level;

    const summary = el('div', { class: `nc-panel nc-summary tone-${level}` },
      el('div', { class: 'nc-summary-top' },
        el('div', {},
          el('h2', { class: 'nc-name' }, report.node.name),
          el('div', { class: 'nc-meta' },
            el('span', { class: 'nc-chip' }, report.node.role),
            el('span', { class: 'nc-key', title: report.node.key }, `${report.node.key.slice(0, 16)}…`),
          ),
        ),
        el('div', { class: 'nc-actions' },
          again,
          copy,
          el('a', { class: 'nc-btn', href: report.analyzerUrl, target: '_blank', rel: 'noopener' }, 'Analyzer ↗'),
        ),
      ),
      el('div', { class: 'nc-status' }, report.verdict.headline),
      el('div', { class: 'nc-stats' },
        stat('Last heard', relative(report.node.lastHeard), shortDate(report.node.lastHeard)),
        stat('Reached', heard.length ? String(heard.length) : '—', heard.length ? `observer${heard.length === 1 ? '' : 's'}, last advert` : 'No recent advert'),
        stat('Regions', advert?.regions.length ? String(advert.regions.length) : '—', advert?.regions.length ? advert.regions.join(', ') : 'None yet'),
        stat('Nearest', nearest == null ? '—' : nearest === 0 ? 'Direct' : `${nearest} ${nearest === 1 ? 'hop' : 'hops'}`,
          report.direct.length ? `${report.direct.length} hear${report.direct.length === 1 ? 's' : ''} it directly` : 'None hear it directly'),
      ),
    );

    const parts: Node[] = [summary, findingsPanel(report.findings)];
    if (heard.length) {
      parts.push(el('div', { class: 'nc-panel' },
        el('div', { class: 'nc-panel-head' },
          el('h2', {}, advert!.kind === 'flood' ? 'Who heard its last flood advert' : 'Who heard its last advert'),
          el('span', { class: 'nc-region-count' }, `Sent ${relative(advert!.at)}`),
        ),
        el('p', { class: 'nc-panel-sub' }, 'Grouped by region, closest first. "Direct" means the observer heard it without any repeater in between.'),
        byRegion(heard),
      ));
    }
    if (report.direct.length) {
      parts.push(el('div', { class: 'nc-panel' },
        el('div', { class: 'nc-panel-head' }, el('h2', {}, 'Observers that hear it directly')),
        el('p', { class: 'nc-panel-sub' }, 'Average signal of everything they\'ve heard straight from this node.'),
        byRegion(report.direct, (o) => el('span', { class: 'nc-hops' }, o.packets == null ? '—' : `${o.packets} pkts`)),
      ));
    }
    result.replaceChildren(el('div', { class: 'nc-stack' }, ...parts));
    remember(report.node.key, report.node.name);
  }

  function renderMessage(level: string, headline: string, ...body: (Node | string | null)[]) {
    result.replaceChildren(el('div', { class: `nc-panel nc-message tone-${level}` }, el('h2', {}, headline), ...body));
  }

  function render(data: Response) {
    switch (data.status) {
      case 'ok':
        renderReport(data);
        break;
      case 'not_found':
        renderMessage('bad', 'We haven\'t heard this node',
          ...data.findings.flatMap((f) => [el('p', {}, f.detail), f.fix ? el('p', {}, f.fix) : null]));
        break;
      case 'choose': {
        const list = el('ul', { class: 'nc-choices' }, ...data.matches.map((m) => {
          const button = el('button', { type: 'button' },
            el('strong', {}, m.name),
            el('span', { class: 'nc-choice-meta' }, `${m.role} · ${m.key.slice(0, 8)}… · heard ${relative(m.lastHeard)}`),
          );
          button.addEventListener('click', () => run(m.key));
          return el('li', {}, button);
        }));
        renderMessage('info', 'Which node is yours?',
          el('p', {}, `More than one node matches “${data.query}”. Pick yours, or enter its public key.`),
          list);
        break;
      }
      default:
        renderMessage('warn', data.status === 'ambiguous' ? 'Enter more of the key' : 'Something went wrong', el('p', {}, data.message));
    }
  }

  async function run(query: string) {
    const trimmed = query.trim();
    if (!trimmed) return;
    input.value = /^[0-9a-f]{8,64}$/i.test(trimmed) ? trimmed.slice(0, 16) : trimmed;
    submit.disabled = true;
    result.replaceChildren(el('p', { class: 'nc-loading' }, 'Checking…'));
    try {
      const response = await fetch(`/api/node-check?q=${encodeURIComponent(trimmed)}`);
      const data = (await response.json()) as Response;
      render(data);
      if (data.status === 'ok') {
        history.replaceState(null, '', `/node-check/${data.node.key.slice(0, 16)}`);
      }
    } catch {
      render({ status: 'error', message: 'Couldn\'t reach the server. Check your connection and try again.' });
    } finally {
      submit.disabled = false;
    }
  }

  form.addEventListener('submit', (event) => {
    event.preventDefault();
    run(input.value);
  });

  showMine();
  // /node-check/<key> opens straight to that node's check.
  const fromPath = location.pathname.match(/^\/node-check\/([0-9a-fA-F]{8,64})\/?$/);
  const fromQuery = new URLSearchParams(location.search).get('q');
  if (fromPath) run(fromPath[1]);
  else if (fromQuery) run(fromQuery);
</script>
