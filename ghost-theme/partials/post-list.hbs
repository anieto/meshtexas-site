<section class="about-section">
  <div class="container-narrow">
    {{#if posts}}
      <div class="article-list">
        {{#foreach posts}}
          {{> "post-card"}}
        {{/foreach}}
      </div>
      {{#match pagination.pages ">" 1}}
        {{pagination}}
      {{/match}}
    {{else}}
      <p class="hint">No articles published yet — check back soon.</p>
    {{/if}}
  </div>
</section>
